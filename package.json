{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
  "start": "bun run src/main.ts",
  "dev": "bun --watch src/main.ts",
  "typecheck": "tsc --noEmit",
  "test": "bun run test:unit && bun run test:integration",
  "test:unit": "bun test src",
  "test:integration": "bun test test/integration --timeout 60000",
  "db:migrate": "bun run src/infra/database/migrate.ts up",
  "db:rollback": "bun run src/infra/database/migrate.ts down",
  "db:status": "bun run src/infra/database/migrate.ts status"
},
  "dependencies": {
    "@mikro-orm/core": "7.2.4",
    "@mikro-orm/migrations": "7.2.4",
    "@mikro-orm/postgresql": "7.2.4",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}